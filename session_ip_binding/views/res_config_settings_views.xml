<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_session_ip_binding" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.session.ip.binding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" string="Session IP binding" data-string="Session IP binding" data-key="session_ip_binding">
                    <h2>Session IP binding</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="session_ip_binding_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="session_ip_binding_enabled"/>
                                <div class="text-muted">Log out a session when its client IP changes.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('session_ip_binding_enabled', '=', False)]}">
                            <div class="o_setting_right_pane">
                                <label for="session_ip_binding_mode"/>
                                <div class="mt8"><field name="session_ip_binding_mode"/></div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
